{
    "name": "issam-moalla/packinglist",
    "description": "Application de gestion de colisage (Packing Lists)",
    "type": "project",
    "authors": [
        {
            "name": "Issam MOALLA",
            "email": "email@example.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "dompdf/dompdf": "^3.1",
        "endroid/qr-code": "^6.0",
        "phpoffice/phpspreadsheet": "^4.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^9"
    }
}
